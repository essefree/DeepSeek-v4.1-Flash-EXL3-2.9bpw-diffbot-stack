# Copy to .env. Paths on the serving box.

# The 2.9 bpw quant, as in the first recipe: a directory (config.json, model.safetensors.index.json,
# the model-*.safetensors shards, tokenizer files) or a Hugging Face repo id, which is fetched into
# <recipe>/models/<org>__<name>. One-off: ./serve.sh --model <dir | org/name>.
MODEL=/home/max/models/DeepSeek-V4.1-Flash-1017-EXL3-2.9bpw
# diffbot's pack, fully downloaded (recipe/ and shards 47/48 are used; the rest is not).
DIFFBOT=/home/max/models/diffbot/DeepSeek-V4.1-Flash-EXL3-3bpw-2x-RTX-PRO-6000
# Where prepare_pack.py assembles the served pack. Default: <quant dir>-served, next to the quant
# (same filesystem -> the unchanged shards are hardlinks; ~17 GB of rewritten shards + 7.4 GB drafter).
# PACK=/home/max/models/DeepSeek-V4.1-Flash-1017-EXL3-2.9bpw-served
# Stock DeepSeek-V4.1-Flash-1017 drafter shards 44-46 (7.4 GiB), fetched here if missing.
STOCK_DRAFTER=/home/max/models/DeepSeek-V4.1-Flash-1017-drafter
# diffbot's serving image (recipe/docker/build.sh) and the plan to derive ours from.
IMAGE=dsv41-flash-1017-exl3-3bpw-sm120
DIFFBOT_PLAN=plan-1017-agent30-c512.json

# --- serve.sh ---
SERVED=deepseek-v4.1-flash-2.9bpw
PORT=8000
# diffbot's knobs you may want to change (see their recipe/serve/serve.sh): MAX_MODEL_LEN, KV_MEM,
# MAX_NUM_SEQS, SPEC_K, CPU_EXPERTS. VRAM is tighter than with their pack only if KV_MEM is raised.
# MAX_MODEL_LEN=1048576
# KV_MEM=4563402752
# SPEC_K=5
# CPU_EXPERTS=0
